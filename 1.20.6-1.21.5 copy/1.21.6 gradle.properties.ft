# Important Notes:
# Every field you add must be added to the root build.gradle expandProps map.

# Project
version=${BUILD_COORDS.version}
group=${BUILD_COORDS.groupId}
java_version=21
deimos_version=2.2

# Common
mod_name=${MOD_NAME}
mod_author=${AUTHORS}
mod_id=${MOD_ID}
license=${LICENSE.id}
homepage=${WEBSITE}
description=${DESCRIPTION}
minecraft_version=1.21.6
modmenu_version=15.0.0-beta.2
minecraft_version_range=[1.21.6, 1.22)
neo_form_version=1.21.6-20250617.151856
parchment_minecraft=1.21.5
parchment_version=2025.06.15
# Fabric
fabric_version=0.127.0+1.21.6
fabric_loader_version=0.16.14
# Forge
forge_version=56.0.0
forge_loader_version_range=[56,)
# NeoForge
neoforge_version=21.6.5-beta
neoforge_loader_version_range=[4,)

# Gradle
org.gradle.jvmargs=-Xmx3G
org.gradle.daemon=false
